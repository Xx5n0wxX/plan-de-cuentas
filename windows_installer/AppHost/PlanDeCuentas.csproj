    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>PlanDeCuentas</AssemblyName>
    <Product>Plan de Cuentas</Product>
    <Company>Plan de Cuentas</Company>
    <Description>Plan de Cuentas - Suite Modular de Finanzas Personales (Escritorio)</Description>
    <Version>2.0.0</Version>
